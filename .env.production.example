# Production environment configuration for Nodvis Finance
# Copy this file to .env before starting the production deployment:
#   cp .env.production.example .env
#
# IMPORTANT: Never commit your actual .env file or production secrets to version control.

# PostgreSQL Configuration
POSTGRES_DB=nodvis_finance
POSTGRES_USER=nodvis_finance
# Generate a strong, unique password (e.g. openssl rand -base64 24)
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

# Database connection URL for web and migration services.
# When running inside Docker Compose, the PostgreSQL host is 'postgres'.
DATABASE_URL=postgresql://nodvis_finance:replace-with-a-strong-postgres-password@postgres:5432/nodvis_finance

# Authentication Configuration (Better Auth)
# Generate a random 32+ character secret (e.g. openssl rand -base64 32)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Canonical application URL used by Better Auth and client redirect flows.
# For production, set this to your domain or LAN address (e.g., https://finance.example.com or http://192.168.1.100:3000)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Service Port
# Port exposed on the host for the web application (default: 3000)
WEB_PORT=3000
