# Advanced environment reference
# Normal self-hosting uses docker-compose.yml and does not need this file.
POSTGRES_DB=nodvis_finance
POSTGRES_USER=nodvis_finance
POSTGRES_PASSWORD=replace-with-a-strong-password
DB_HOST=postgres
DB_PORT=5432
DB_NAME=nodvis_finance
DB_USER=nodvis_finance
DB_PASSWORD=replace-with-the-same-strong-password
BETTER_AUTH_SECRET=replace-with-a-different-random-secret
BETTER_AUTH_URL=http://localhost:3990
NEXT_PUBLIC_APP_URL=http://localhost:3990
# First-owner signup closes automatically after bootstrap.
