# Development defaults only. Never commit real production secrets.

POSTGRES_DB=nodvis_finance
POSTGRES_USER=nodvis_finance
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql://nodvis_finance:change-me-local-only@localhost:5432/nodvis_finance

# Generate a strong random secret for every real deployment.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

NEXT_PUBLIC_APP_URL=http://localhost:3000

# The first owner is claimed atomically by the setup flow. Public signup is
# closed permanently after initialization.
